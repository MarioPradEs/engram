package dashboard

// AdminGamesCompactPage renders the admin games page with a unified editable table:
//   - One row per existing game: editable name input + color picker + Save + Delete (X).
//   - One extra "add" row at the bottom: empty name + color + Add button.
//   - The separate "Games Vocabulary" textarea is removed; its function is absorbed here.
//
// games is the current list from the in-memory ClassrulesLoader.
// gameColors maps slug → current hex color (empty string = unset).
// flashMessage / flashIsError carry flash state surfaced via the redirect query param.
templ AdminGamesCompactPage(games []string, gameColors map[string]string, flashMessage string, flashIsError bool) {
	<section class="frame-section">
		<div class="section-header">
			<div>
				<p class="section-kicker">ADMIN</p>
				<h2>Games</h2>
			</div>
		</div>
		@adminNav("games")
		if flashMessage != "" {
			if flashIsError {
				<div class="flash-message flash-error">{ flashMessage }</div>
			} else {
				<div class="flash-message flash-success">{ flashMessage }</div>
			}
		}
		<div class="open-item-notice">
			<strong>Note:</strong> Running <code>engram mcp</code> client processes pick up changes
			on their next reconnect/restart — the cloud server cannot push into running client
			processes. Per-dev propagation is a follow-up feature (S4, hook-pull).
		</div>
		<p class="section-note">
			Edit game names and border colors for the brain graph view.
			Changes are written atomically to <code>classification-rules.yaml</code>.
		</p>
		<table class="data-table spreadsheet-table">
			<thead>
				<tr>
					<th>Game</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, game := range games {
					<tr>
						<td>
							<form
								method="POST"
								action="/dashboard/admin/games/save"
								class="inline-game-row-form"
							>
								<input type="hidden" name="original" value={ game }/>
								<input
									type="text"
									name="name"
									value={ game }
									class="input-game-name"
									aria-label={ "Game name for " + game }
									required
								/>
								<input
									type="color"
									name="color"
									value={ colorOrFallback(gameColors[game], "#888888") }
									aria-label={ "Border color for " + game }
								/>
								<button type="submit" class="btn-small">Save</button>
							</form>
						</td>
						<td>
							<form
								method="POST"
								action="/dashboard/admin/games/delete"
								class="inline-delete-form"
							>
								<input type="hidden" name="name" value={ game }/>
								<button type="submit" class="btn-small btn-danger">X</button>
							</form>
						</td>
					</tr>
				}
				<tr class="games-add-row">
					<td colspan="2">
						<form
							method="POST"
							action="/dashboard/admin/games/save"
							class="inline-game-row-form"
						>
							<input type="hidden" name="original" value=""/>
							<input
								type="text"
								name="name"
								value=""
								class="input-game-name"
								placeholder="+ new game"
								aria-label="New game name"
							/>
							<input
								type="color"
								name="color"
								value="#888888"
								aria-label="Color for new game"
							/>
							<button type="submit" class="btn-small btn-primary">Add</button>
						</form>
					</td>
				</tr>
			</tbody>
		</table>
	</section>
}

// AdminDepartmentsPage renders the admin departments page with a unified editable table:
//   - One row per existing department: editable name input + color picker + Save + Delete (X).
//   - One extra "add" row at the bottom: empty name + color + Add button.
//   - Sourced from the canonical departments list in classification-rules.yaml.
//
// departments is the current list of department names from the ClassrulesLoader.
// deptColors maps dept name → current hex color (empty string = unset).
// flashMessage / flashIsError carry flash state surfaced via the redirect query param.
templ AdminDepartmentsPage(departments []string, deptColors map[string]string, flashMessage string, flashIsError bool) {
	<section class="frame-section">
		<div class="section-header">
			<div>
				<p class="section-kicker">ADMIN</p>
				<h2>Departments</h2>
			</div>
		</div>
		@adminNav("departments")
		if flashMessage != "" {
			if flashIsError {
				<div class="flash-message flash-error">{ flashMessage }</div>
			} else {
				<div class="flash-message flash-success">{ flashMessage }</div>
			}
		}
		<div class="open-item-notice">
			<strong>Note:</strong> Department names must match the <code>department</code> field
			in <code>users.yaml</code> so the brain graph can apply fill colors correctly.
		</div>
		<p class="section-note">
			Edit department names and fill colors for the brain graph view.
			Changes are written atomically to <code>classification-rules.yaml</code>.
		</p>
		<table class="data-table spreadsheet-table">
			<thead>
				<tr>
					<th>Department</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, dept := range departments {
					<tr>
						<td>
							<form
								method="POST"
								action="/dashboard/admin/departments/save"
								class="inline-game-row-form"
							>
								<input type="hidden" name="original" value={ dept }/>
								<input
									type="text"
									name="name"
									value={ dept }
									class="input-game-name"
									aria-label={ "Department name for " + dept }
									required
								/>
								<input
									type="color"
									name="color"
									value={ colorOrFallback(deptColors[dept], "#555555") }
									aria-label={ "Fill color for department " + dept }
								/>
								<button type="submit" class="btn-small">Save</button>
							</form>
						</td>
						<td>
							<form
								method="POST"
								action="/dashboard/admin/departments/delete"
								class="inline-delete-form"
							>
								<input type="hidden" name="name" value={ dept }/>
								<button type="submit" class="btn-small btn-danger">X</button>
							</form>
						</td>
					</tr>
				}
				<tr class="games-add-row">
					<td colspan="2">
						<form
							method="POST"
							action="/dashboard/admin/departments/save"
							class="inline-game-row-form"
						>
							<input type="hidden" name="original" value=""/>
							<input
								type="text"
								name="name"
								value=""
								class="input-game-name"
								placeholder="+ new department"
								aria-label="New department name"
							/>
							<input
								type="color"
								name="color"
								value="#555555"
								aria-label="Color for new department"
							/>
							<button type="submit" class="btn-small btn-primary">Add</button>
						</form>
					</td>
				</tr>
			</tbody>
		</table>
	</section>
}

// colorOrFallback returns value if non-empty, otherwise fallback.
func colorOrFallback(value, fallback string) string {
	if value != "" {
		return value
	}
	return fallback
}
