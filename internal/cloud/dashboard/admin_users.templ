package dashboard

import "strings"

// AdminUsersManagementPage renders the unified admin Users page:
//   - Add-user toolbar (email, name, department, role).
//   - Compact card-row list of provisioned users with per-row inline editable
//     fields (email, name, department, role) + activate/deactivate + delete.
//
// All write actions POST to /dashboard/admin/users/add|edit|deactivate|delete,
// which delegate to the member-management handlers and redirect back here.
// Admin-only — caller must verify p.IsAdmin() before rendering.
//
// callerEmail is the current principal's email. When a row matches the caller's
// email (case-insensitive), self-destructive controls (email/role edit,
// deactivate, delete) are disabled. The server-side guard is authoritative.
templ AdminUsersManagementPage(members []ProvisionedUser, departments []string, flashMessage string, flashIsError bool, callerEmail string, pendingCount int) {
	<section class="frame-section">
		<div class="section-header">
			<div>
				<p class="section-kicker">ADMIN</p>
				<h2>Users</h2>
			</div>
		</div>
		@adminNav("users", pendingCount)
		if flashMessage != "" {
			if flashIsError {
				<div class="flash-message flash-error">{ flashMessage }</div>
			} else {
				<div class="flash-message flash-success">{ flashMessage }</div>
			}
		}
		<h3 class="section-block-title">Add User</h3>
		<form method="POST" action="/dashboard/admin/users/add" class="user-add-bar">
			<input type="email" name="email" placeholder="user@vivastudios.com" required/>
			<input type="text" name="name" placeholder="Full name"/>
			<select name="department" aria-label="Department">
				if len(departments) == 0 {
					<option value="dev">dev</option>
					<option value="art">art</option>
					<option value="qa">qa</option>
				} else {
					for _, d := range departments {
						<option value={ d }>{ d }</option>
					}
				}
			</select>
			<select name="role" aria-label="Role">
				<option value="member">member</option>
				<option value="admin">admin</option>
			</select>
			<button type="submit" class="btn-small btn-primary">Add</button>
		</form>
		<h3 class="section-block-title">Provisioned Users</h3>
		if len(members) == 0 {
			@EmptyState("No Provisioned Users", "Add a user above or provision users by editing users.yaml directly.")
		} else {
			<div class="user-list">
				for _, m := range members {
					<div class="user-row">
						<form method="POST" action="/dashboard/admin/users/edit" class="user-edit">
							<input type="hidden" name="original_email" value={ m.Email }/>
							<input
								type="email"
								name="email"
								value={ m.Email }
								required
								aria-label="Email"
								class="u-email"
								disabled?={ strings.EqualFold(m.Email, callerEmail) }
							/>
							<input type="text" name="name" value={ m.Name } aria-label="Name" placeholder="Name" class="u-name"/>
							<select name="department" aria-label="Department" class="u-dept">
								if len(departments) == 0 {
									<option value={ m.Department } selected>{ m.Department }</option>
								} else {
									for _, d := range departments {
										<option value={ d } selected?={ m.Department == d }>{ d }</option>
									}
								}
							</select>
							<select name="role" aria-label="Role" class="u-role" disabled?={ strings.EqualFold(m.Email, callerEmail) }>
								<option value="admin" selected?={ m.Role == "admin" }>admin</option>
								<option value="member" selected?={ m.Role == "member" }>member</option>
							</select>
							<button type="submit" class="btn-small" title="Save changes">Save</button>
						</form>
						<div class="user-meta">
							if m.Status == "active" {
								@StatusBadge("Active", "success")
							} else if m.Status == "offboarding" {
								@StatusBadge("Offboarding", "warning")
							} else {
								@StatusBadge(m.Status, "danger")
							}
						</div>
						<div class="user-actions">
							if strings.EqualFold(m.Email, callerEmail) {
								<span class="btn-small" style="opacity:0.4;cursor:default;" title="You can't deactivate your own account.">Deactivate</span>
								<span class="btn-small btn-danger" style="opacity:0.4;cursor:default;" title="You can't delete your own account.">✕</span>
							} else {
								if m.Status == "active" {
									<form method="POST" action="/dashboard/admin/users/deactivate" class="inline-delete-form">
										<input type="hidden" name="email" value={ m.Email }/>
										<input type="hidden" name="status" value="removed"/>
										<button type="submit" class="btn-small btn-danger" onclick="return confirm('Deactivate ' + this.closest('form').email.value + '?')">Deactivate</button>
									</form>
								} else {
									<form method="POST" action="/dashboard/admin/users/edit" class="inline-delete-form">
										<input type="hidden" name="original_email" value={ m.Email }/>
										<input type="hidden" name="email" value={ m.Email }/>
										<input type="hidden" name="status" value="active"/>
										<button type="submit" class="btn-small">Activate</button>
									</form>
								}
								<form method="POST" action="/dashboard/admin/users/delete" class="inline-delete-form">
									<input type="hidden" name="email" value={ m.Email }/>
									<button type="submit" class="btn-small btn-danger" onclick="return confirm('Permanently delete ' + this.closest('form').email.value + '? This cannot be undone.')">✕</button>
								</form>
							}
						</div>
					</div>
				}
			</div>
		}
	</section>
}
