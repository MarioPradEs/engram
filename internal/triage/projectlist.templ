package triage

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/Gentleman-Programming/engram/internal/store"
)

// ObservationRow is the view model for a single observation in the project list.
// It carries the pre-computed UI scope and needs-triage flag.
type ObservationRow struct {
	Obs         store.Observation
	UIScope     string // "shared", "personal"
	NeedsTriage bool
}

// ProjectListPage renders the per-project observation list with inline scope toggles.
// Observations are pre-sorted by the handler (newest first via store query).
// cwdProject is the project name that matches the cwd at server launch time;
// classify controls are only rendered when project == cwdProject (Option A, W-1).
templ ProjectListPage(project string, rows []ObservationRow, cwdProject string) {
	<section>
		<a href="/" class="back-link">← All Projects</a>
		<h2>
			{ project }
		</h2>
		if len(rows) == 0 {
			<p class="empty-state">No observations found for this project.</p>
		} else {
			<p class="triage-subtitle">{ fmt.Sprintf("%d observation(s)", len(rows)) }</p>
			<div class="bulk-actions">
				<form method="POST" action={ templ.SafeURL("/project/" + url.PathEscape(project) + "/set-scope") }>
					<input type="hidden" name="scope" value="shared"/>
					<button type="submit" class="btn-bulk-share">Mark all as shared</button>
				</form>
				<form method="POST" action={ templ.SafeURL("/project/" + url.PathEscape(project) + "/set-scope") }>
					<input type="hidden" name="scope" value="personal"/>
					<button type="submit" class="btn-bulk-personal">Mark all as personal</button>
				</form>
				if project == cwdProject {
					<form method="POST" action={ templ.SafeURL("/project/" + url.PathEscape(project) + "/classify") }>
						<input type="hidden" name="scope" value="shared"/>
						<button type="submit" class="btn-classify">Set default: shared</button>
					</form>
					<form method="POST" action={ templ.SafeURL("/project/" + url.PathEscape(project) + "/classify") }>
						<input type="hidden" name="scope" value="personal"/>
						<button type="submit" class="btn-classify">Set default: personal</button>
					</form>
				}
			</div>
			<div class="obs-list">
				for _, row := range rows {
					@ObsRowView(row, project)
				}
			</div>
		}
		<p class="triage-warning-notice">
			Scope changes apply to new observations saved after this toggle. Pre-sync observations already sent cannot be recalled (Gate A is v1.5).
		</p>
	</section>
}

// ObsRowView renders a single observation row with its scope badge and inline toggle.
templ ObsRowView(row ObservationRow, project string) {
	<div class="obs-row">
		<span class="obs-title">{ row.Obs.Title }</span>
		if row.NeedsTriage {
			<span class="badge badge-triage">needs triage</span>
			<span class="obs-toggle">
				<form method="POST" action={ templ.SafeURL("/observations/" + strconv.FormatInt(row.Obs.ID, 10) + "/scope") }>
					<input type="hidden" name="scope" value="shared"/>
					<button type="submit" class="btn-toggle">→ shared</button>
				</form>
				<form method="POST" action={ templ.SafeURL("/observations/" + strconv.FormatInt(row.Obs.ID, 10) + "/scope") }>
					<input type="hidden" name="scope" value="personal"/>
					<button type="submit" class="btn-toggle">→ personal</button>
				</form>
			</span>
		} else if row.UIScope == "shared" {
			<span class="badge badge-shared">shared</span>
			<span class="obs-toggle">
				<form method="POST" action={ templ.SafeURL("/observations/" + strconv.FormatInt(row.Obs.ID, 10) + "/scope") }>
					<input type="hidden" name="scope" value="personal"/>
					<button type="submit" class="btn-toggle">→ personal</button>
				</form>
			</span>
		} else {
			<span class="badge badge-personal">personal</span>
			<span class="obs-toggle">
				<form method="POST" action={ templ.SafeURL("/observations/" + strconv.FormatInt(row.Obs.ID, 10) + "/scope") }>
					<input type="hidden" name="scope" value="shared"/>
					<button type="submit" class="btn-toggle">→ shared</button>
				</form>
			</span>
		}
		<span class="obs-meta">{ row.Obs.Type }</span>
	</div>
}

// SetScopeConfirmPage renders the direction-sensitive bulk set-scope confirmation
// prompt (D7, REQ-36). It is displayed when POST /project/{name}/set-scope is
// called without confirm=1.
//
// scope=="shared": includes sync-risk warning (observations already sent cannot be recalled).
// scope=="personal": lighter copy, no sync-risk warning.
templ SetScopeConfirmPage(project string, count int, scope string) {
	<section>
		<a href={ templ.SafeURL("/project/" + url.PathEscape(project)) } class="back-link">← Back to { project }</a>
		if scope == "shared" {
			<h2>Confirm: mark all as shared</h2>
			<p>
				You are about to mark <strong>{ fmt.Sprintf("%d", count) } observation(s)</strong> in
				<strong>{ project }</strong> as <em>shared</em>.
			</p>
			<p class="triage-warning-notice">
				This moves the project backlog to the shared tier. Observations already sent cannot be recalled (Gate A is v1.5).
			</p>
		} else {
			<h2>Confirm: mark all as personal</h2>
			<p>
				You are about to mark <strong>{ fmt.Sprintf("%d", count) } observation(s)</strong> in
				<strong>{ project }</strong> as <em>personal</em>.
			</p>
			<p>These observations will no longer be shared with the team.</p>
		}
		<form method="POST" action={ templ.SafeURL("/project/" + url.PathEscape(project) + "/set-scope") }>
			<input type="hidden" name="scope" value={ scope }/>
			<input type="hidden" name="confirm" value="1"/>
			<button type="submit" class="btn-confirm-share">Yes, mark { fmt.Sprintf("%d", count) } as { scope }</button>
		</form>
		<a href={ templ.SafeURL("/project/" + url.PathEscape(project)) } class="btn-cancel">Cancel</a>
	</section>
}
