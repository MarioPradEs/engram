package triage

import (
	"fmt"
	"net/url"

	"github.com/Gentleman-Programming/engram/internal/store"
)

// ProjectsPage renders the landing page with all projects grouped by name.
// cwdProject is the project name matching the server's launch directory.
// cwdDefault is the resolved default scope for the cwd project ("shared"/"personal").
// cwdHasExplicit is true when the cwd project has an explicit default_scope in config.json.
templ ProjectsPage(projects []store.ProjectStats, cwdProject string, cwdDefault string, cwdHasExplicit bool) {
	<section>
		<div class="section-header">
			<h2>Projects</h2>
			<p class="triage-subtitle">{ fmt.Sprintf("%d project(s) in local store", len(projects)) }</p>
		</div>
		<div class="triage-warning-notice">
			Scope changes set new observations only. Pre-sync observations already sent to the cloud cannot be recalled (Gate A is v1.5).
		</div>
		if len(projects) == 0 {
			<p class="empty-state">No projects found in local store.</p>
		} else {
			<div class="project-grid">
				for _, p := range projects {
					@ProjectCard(p, cwdProject, cwdDefault, cwdHasExplicit)
				}
			</div>
		}
	</section>
}

// ProjectCard renders a single project summary card.
// Every card shows bulk set-scope buttons ("Mark all as shared" / "Mark all as
// personal") targeting /project/{name}/set-scope (WU-A6, REQ-07 / Scenario A-04).
// Only the cwdProject also shows a resolved default-scope badge and classify
// controls (Option A, cwd-only).
// The bulk-actions block is placed after the </a> anchor to avoid nesting
// interactive elements inside an anchor (invalid HTML).
templ ProjectCard(p store.ProjectStats, cwdProject string, cwdDefault string, cwdHasExplicit bool) {
	<div class="project-card">
		<a href={ templ.SafeURL("/project/" + url.PathEscape(p.Name)) }>
			<h3>
				{ p.Name }
				if p.Name == cwdProject {
					<span class="badge badge-default">default: { cwdDefault }</span>
					if !cwdHasExplicit {
						<span class="badge badge-triage">unset</span>
					}
				}
			</h3>
			<p class="project-meta">
				{ fmt.Sprintf("%d observations · %d sessions", p.ObservationCount, p.SessionCount) }
			</p>
		</a>
		<div class="bulk-actions">
			<form method="POST" action={ templ.SafeURL("/project/" + url.PathEscape(p.Name) + "/set-scope") }>
				<input type="hidden" name="scope" value="shared"/>
				<button type="submit" class="btn-bulk-share">Mark all as shared</button>
			</form>
			<form method="POST" action={ templ.SafeURL("/project/" + url.PathEscape(p.Name) + "/set-scope") }>
				<input type="hidden" name="scope" value="personal"/>
				<button type="submit" class="btn-bulk-personal">Mark all as personal</button>
			</form>
		</div>
		if p.Name == cwdProject {
			<div class="classify-controls">
				<form method="POST" action={ templ.SafeURL("/project/" + url.PathEscape(p.Name) + "/classify") }>
					<input type="hidden" name="scope" value="shared"/>
					<button type="submit" class="btn-classify">Set default: shared</button>
				</form>
				<form method="POST" action={ templ.SafeURL("/project/" + url.PathEscape(p.Name) + "/classify") }>
					<input type="hidden" name="scope" value="personal"/>
					<button type="submit" class="btn-classify">Set default: personal</button>
				</form>
			</div>
		}
	</div>
}
